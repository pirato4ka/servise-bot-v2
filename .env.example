# Скопируй этот файл: cp .env.example .env  — и заполни своими значениями
# НИКОГДА не коммить .env: он уже добавлен в .gitignore

# Токен бота из @BotFather
BOT_TOKEN=123456789:AAH_your_telegram_bot_token_here

# ID админ-чата (супергруппа, например -1001234567890)
ADMIN_CHAT_ID=-1001234567890

# Токен приложения CryptoBot: @CryptoBot -> /pay -> Create App
CRYPTO_BOT_TOKEN=12345:AAH_your_cryptobot_app_token

# False = тестовая сеть (@CryptoTestnetBot), True = реальные деньги
CRYPTO_BOT_IS_MAINNET=False

# Путь к базе SQLite.
# В Docker каталог должен быть доступен на запись процессу бота.
# Если каталог недоступен, бот сам уйдёт в запасной (/app/data/bot.db, ./bot.db, /tmp/bot.db)
# и напишет об этом в лог — но данные могут не пережить пересборку контейнера.
DB_PATH=bot.db

# Прокси (необязательно). Поддерживается http://, https:// и socks5://
# Для socks требуется пакет aiohttp_socks (он есть в requirements.txt)
PROXY_URL=
PROXY_URL_CRYPTO=

# Как часто опрашивать CryptoBot по неоплаченным счетам, секунды (0 = выключить)
INVOICE_POLL_INTERVAL=60

# Подробное логирование всех входящих апдейтов (только для отладки)
DEBUG_ALL=False
